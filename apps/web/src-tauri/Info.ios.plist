<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  iOS-only Info.plist keys. Tauri merges this on top of the generated iOS
  Info.plist (this file is the iOS-specific source in the merge order). These
  cannot be expressed in tauri.conf.json as of Tauri 2.x, so they live here.
-->
<plist version="1.0">
<dict>
	<!--
	  Required by App Store validation whenever the HealthKit entitlement is
	  present, even though this app never writes to Health: the plugin asks for
	  `toShare: nil` (plugins/health/ios/Sources/HealthKit.swift). Omitting it
	  fails upload with a 409, not a warning. It lives here rather than in
	  gen/apple/project.yml because xcodegen only runs at `tauri ios init`, so
	  project.yml edits do not reach an already-generated project.
	-->
	<key>NSHealthUpdateUsageDescription</key>
	<string>Virtues does not write anything to Health. It only reads your health data to build your personal timeline, stored on your own box.</string>
	<key>NSLocationWhenInUseUsageDescription</key>
	<string>Virtues records your location to build your personal timeline.</string>
	<key>NSLocationAlwaysAndWhenInUseUsageDescription</key>
	<string>Virtues records your location in the background to build your personal timeline, even when the app is closed.</string>
	<key>NSLocationAlwaysUsageDescription</key>
	<string>Virtues records your location in the background to build your personal timeline, even when the app is closed.</string>
	<key>UIBackgroundModes</key>
	<array>
		<string>location</string>
		<string>audio</string>
		<string>processing</string>
		<string>fetch</string>
	</array>
	<key>BGTaskSchedulerPermittedIdentifiers</key>
	<array>
		<string>com.virtues.ios.sync</string>
	</array>
	<key>NSAppTransportSecurity</key>
	<dict>
		<key>NSAllowsLocalNetworking</key>
		<true/>
	</dict>
	<key>NSLocalNetworkUsageDescription</key>
	<string>Virtues connects to your box on your local network to pair and sync your data.</string>
	<!--
	  Chat attachments: the webview's file input offers "Take Photo or Video".
	  iOS TERMINATES the app (not a permission denial — an instant kill) if the
	  camera sheet opens without NSCameraUsageDescription. The photo-library
	  string covers the photos collector (plugins/photos, which asks for full
	  library access) and the non-PHPicker library paths WKWebView can route
	  chat attachments through. This file is merged last, so the string here is
	  the one iOS shows.
	-->
	<key>NSCameraUsageDescription</key>
	<string>Virtues uses the camera when you attach a photo or video in chat — sent to your own box, not Virtues&apos; servers.</string>
	<!-- With Limited access, iOS would otherwise ask to pick more photos on the
	     first library read of each launch; the device screen says the access is limited. -->
	<key>PHPhotoLibraryPreventAutomaticLimitedAccessAlert</key>
	<true/>
	<key>NSPhotoLibraryUsageDescription</key>
	<string>Virtues reads when and where your photos were taken and keeps a smaller copy of each favorite. It also uses photos you attach in chat.</string>
	<key>NSBonjourServices</key>
	<array>
		<string>_http._tcp</string>
	</array>
	<!--
	  The UIScene lifecycle. An app built with the iOS 27 SDK that does not
	  declare a scene manifest is stopped by UIKit at launch, before any app
	  code runs. UIKit checks only this static manifest, so the configuration
	  must name tao's scene delegate here even though tao also hands UIKit one
	  at runtime. TaoSceneDelegate is tao's Objective-C class name (tao 0.37+,
	  src/platform_impl/ios/scene.rs); older tao crashes release builds when
	  this key is present. One scene only: the app has a single window.
	-->
	<key>UIApplicationSceneManifest</key>
	<dict>
		<key>UIApplicationSupportsMultipleScenes</key>
		<false/>
		<key>UISceneConfigurations</key>
		<dict>
			<key>UIWindowSceneSessionRoleApplication</key>
			<array>
				<dict>
					<key>UISceneConfigurationName</key>
					<string>Default Configuration</string>
					<key>UISceneDelegateClassName</key>
					<string>TaoSceneDelegate</string>
				</dict>
			</array>
		</dict>
	</dict>
</dict>
</plist>
