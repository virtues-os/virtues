{
  "$schema": "https://schemas.tauri.app/capability/schema.json",
  "identifier": "mac",
  "description": "The Mac's main window. Every page it shows is the app's OWN copy, at virtues://localhost (src-tauri serve_ui; agents/plan/local-ui-plan.md), which Tauri treats as local, so there is no `remote` block: no page the box serves is ever given the app's commands on a Mac. That is the point of the split from default.json (Windows and Linux, which still load the box's copy and so still need the remote grant). Same permissions otherwise; build.rs checks both files against APP_COMMANDS.",
  "platforms": [
    "macOS"
  ],
  "windows": [
    "*"
  ],
  "permissions": [
    "allow-command-surface-version",
    "allow-shell-identity-cmd",
    "allow-bundle-boot-ok",
    "allow-bundle-update-ready",
    "allow-ota-check-now",
    "allow-update-state-cmd",
    "allow-apply-update-cmd",
    "allow-check-app-update-cmd",
    "allow-get-client-status",
    "allow-discover-servers",
    "allow-pair-with-code",
    "allow-install-helpers",
    "allow-uninstall-helpers",
    "allow-forget-pairing",
    "allow-recheck-box",
    "allow-diagnose-box",
    "allow-restart-app",
    "allow-get-collector-status",
    "allow-install-collector",
    "allow-uninstall-collector",
    "allow-pause-collector",
    "allow-resume-collector",
    "allow-stop-collector",
    "allow-recheck-collector",
    "allow-open-full-disk-access",
    "allow-open-accessibility-settings",
    "allow-set-summon-shortcut",
    "allow-browser-login",
    "allow-browser-pane-open",
    "allow-browser-pane-bounds",
    "allow-browser-pane-go",
    "allow-browser-pane-agent",
    "core:default",
    "reach:default",
    "core:window:allow-create",
    "core:window:allow-get-all-windows",
    "core:window:allow-set-focus",
    "core:window:allow-set-title-bar-style",
    "core:window:allow-start-dragging",
    "core:webview:allow-set-webview-zoom",
    "core:webview:allow-print",
    "opener:default",
    "updater:default",
    "notification:default",
    "shell:allow-open"
  ]
}
