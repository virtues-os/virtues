{
  "$schema": "https://schemas.tauri.app/capability/schema.json",
  "identifier": "mobile",
  "description": "Capabilities for the iOS build (collectors + reach). Android is viewer-only — see android.json",
  "platforms": ["iOS"],
  "windows": ["*"],
  "permissions": [
    "core:default",
    "core:window:allow-create",
    "location-probe:default",
    "reach:default",
    "health:default",
    "eventkit:default",
    "contacts:default",
    "finance:default",
    "audio:default"
  ]
}
