{
  "$schema": "https://schemas.tauri.app/capability/schema.json",
  "identifier": "default",
  "description": "Default capabilities for the main window. The allow-* entries below are the app's OWN commands: the paired window loads the box-served SPA over loopback HTTP, which Tauri classifies as a REMOTE origin, and a remote origin is granted no app command unless its permission resolves. Without them Settings > This Mac died with 'Command get_collector_status not allowed by ACL' while the collector ran fine. build.rs APP_COMMANDS is the source of truth and fails the build if this list drifts.",
  "platforms": ["macOS", "windows", "linux"],
  "windows": ["*"],
  "permissions": [
    "allow-command-surface-version",
    "allow-shell-identity-cmd",
    "allow-bundle-boot-ok",
    "allow-update-state-cmd",
    "allow-apply-update-cmd",
    "allow-check-app-update-cmd",
    "allow-get-client-status",
    "allow-discover-servers",
    "allow-pair-with-code",
    "allow-install-helpers",
    "allow-uninstall-helpers",
    "allow-forget-pairing",
    "allow-recheck-box",
    "allow-diagnose-box",
    "allow-restart-app",
    "allow-get-collector-status",
    "allow-install-collector",
    "allow-uninstall-collector",
    "allow-pause-collector",
    "allow-resume-collector",
    "allow-stop-collector",
    "allow-open-full-disk-access",
    "allow-open-accessibility-settings",
    "allow-set-summon-shortcut",
    "core:default",
    "reach:default",
    "core:window:allow-create",
    "core:window:allow-get-all-windows",
    "core:window:allow-set-focus",
    "core:webview:allow-set-webview-zoom",
    "opener:default",
    "updater:default",
    "notification:default",
    "shell:allow-open",
    {
      "identifier": "shell:allow-execute",
      "allow": [
        {
          "name": "binaries/virtues-collector",
          "sidecar": true,
          "args": true
        },
        {
          "name": "binaries/virtues-client",
          "sidecar": true,
          "args": true
        },
        {
          "name": "osascript",
          "args": true
        }
      ]
    },
    {
      "identifier": "shell:allow-spawn",
      "allow": [
        {
          "name": "binaries/virtues-collector",
          "sidecar": true,
          "args": true
        },
        {
          "name": "binaries/virtues-client",
          "sidecar": true,
          "args": true
        },
        {
          "name": "open",
          "args": true
        },
        {
          "name": "osascript",
          "args": true
        }
      ]
    }
  ],
  "remote": {
    "urls": [
      "https://virtues.com/*",
      "https://*.virtues.com/*",
      "https://localhost:*/*",
      "http://localhost:*/*",
      "http://*.virtues:*/*"
    ]
  }
}
