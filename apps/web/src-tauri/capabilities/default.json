{
  "$schema": "https://schemas.tauri.app/capability/schema.json",
  "identifier": "default",
  "description": "Windows and Linux main window (the Mac has its own, capabilities/mac.json, with no remote grant, since 2026-09-29). The allow-* entries below are the app's OWN commands: the paired window loads the box-served SPA over loopback HTTP, which Tauri classifies as a REMOTE origin, and a remote origin is granted no app command unless its permission resolves. Without them Settings > This Mac died with 'Command get_collector_status not allowed by ACL' while the collector ran fine. build.rs APP_COMMANDS is the source of truth and fails the build if this list drifts.",
  "platforms": ["windows", "linux"],
  "windows": ["*"],
  "permissions": [
    "allow-command-surface-version",
    "allow-shell-identity-cmd",
    "allow-bundle-boot-ok",
    "allow-bundle-update-ready",
    "allow-ota-check-now",
    "allow-update-state-cmd",
    "allow-apply-update-cmd",
    "allow-check-app-update-cmd",
    "allow-get-client-status",
    "allow-discover-servers",
    "allow-pair-with-code",
    "allow-install-helpers",
    "allow-uninstall-helpers",
    "allow-forget-pairing",
    "allow-recheck-box",
    "allow-diagnose-box",
    "allow-restart-app",
    "allow-get-collector-status",
    "allow-install-collector",
    "allow-uninstall-collector",
    "allow-pause-collector",
    "allow-resume-collector",
    "allow-stop-collector",
    "allow-recheck-collector",
    "allow-open-full-disk-access",
    "allow-open-accessibility-settings",
    "allow-set-summon-shortcut",
    "core:default",
    "reach:default",
    "core:window:allow-create",
    "core:window:allow-get-all-windows",
    "core:window:allow-set-focus",
    "core:window:allow-set-title-bar-style",
    "core:window:allow-start-dragging",
    "core:webview:allow-set-webview-zoom",
    "opener:default",
    "updater:default",
    "notification:default",
    "shell:allow-open"
  ],
  "remote": {
    "urls": [
      "http://localhost:*/*"
    ]
  }
}
