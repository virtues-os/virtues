# systemd USER unit for virtues-client.
#
# Installs to ~/.config/systemd/user/virtues-client.service
# Enable + start with:
#     systemctl --user enable --now virtues-client.service
#
# Why a user unit (not system):
#   - The pairing bundle + WG private key live in the user's OS keyring
#     (libsecret on Linux, accessed only from the user's session).
#   - The proxy listens on the user's loopback :8000 — a per-user concern.
#   - System-wide install would force every login session to share one
#     paired identity, which contradicts our single-user-per-device model.
#
# Capabilities (install-time, NOT runtime):
#   `AmbientCapabilities=` is silently ignored by systemd in `--user` mode
#   (the kernel restricts capability grants to PID-1 / system services).
#   So we don't try to grant CAP_NET_ADMIN from the unit. Instead the
#   installer runs ONCE:
#
#       sudo setcap cap_net_admin+ep /usr/local/bin/virtues-client
#
#   That puts the capability on the binary itself. On binary upgrades the
#   installer re-applies setcap; users running `cargo install` for dev
#   need to setcap by hand.

[Unit]
Description=Virtues desktop daemon — WireGuard tunnel + localhost proxy
Documentation=https://virtues.com/docs
After=network-online.target dbus.socket
Wants=network-online.target

[Service]
Type=simple
ExecStart=/usr/local/bin/virtues-client up
Restart=on-failure
RestartSec=3s

# Hardening — drop everything the daemon doesn't need.
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict

# $HOME stays read-only, but punch a hole for libsecret's keyring directory
# so `keyring::Entry::set_password` can persist the pairing bundle + WG
# private key. Without ReadWritePaths the first `virtues-client pair` under
# systemd hits a permission error and the unit restart-loops.
ProtectHome=read-only
ReadWritePaths=%h/.local/share/keyrings

ProtectKernelTunables=true
ProtectKernelModules=true
ProtectKernelLogs=true
ProtectControlGroups=true
RestrictNamespaces=true
RestrictRealtime=true
RestrictSUIDSGID=true
LockPersonality=true
MemoryDenyWriteExecute=true
SystemCallArchitectures=native

# Logging
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=default.target
