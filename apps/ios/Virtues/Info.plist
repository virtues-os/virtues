<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>BGTaskSchedulerPermittedIdentifiers</key>
	<array>
		<string>com.virtues.ios.refresh</string>
		<string>com.virtues.ios.processing</string>
		<string>com.virtues.ios.sync</string>
	</array>
	<key>NSAppTransportSecurity</key>
	<dict>
		<!-- The box is a self-hosted server the user owns, reached over plain
		     HTTP on the LAN, a Tailscale IP (100.64.0.0/10), or an encrypted iroh
		     transport. Pairing ("consume") is a one-time cleartext POST with a
		     rotating code before the device is allowlisted for iroh; ATS
		     exceptions can't be scoped to a dynamic tailnet IP, so allow arbitrary
		     cleartext loads. Sensitive data traffic runs over iroh (QUIC), not
		     this URLSession path.
		     NOTE: `NSAllowsArbitraryLoads` MUST stand alone — if
		     `NSAllowsLocalNetworking` (or the media/web-content keys) is also
		     present, iOS 10+ IGNORES `NSAllowsArbitraryLoads`. That's the trap
		     that kept cleartext to the tailnet IP blocked. -->
		<key>NSAllowsArbitraryLoads</key>
		<true/>
	</dict>
	<key>NSCalendarsFullAccessUsageDescription</key>
	<string>Virtues syncs your calendar events to build a timeline of your schedule and activities.</string>
	<key>NSCameraUsageDescription</key>
	<string>Virtues uses the camera to scan QR codes for quick device pairing with your server.</string>
	<key>NSFinanceUsageDescription</key>
	<string>Virtues uses FinanceKit to securely sync your Apple Card and Apple Cash transactions for local analysis.</string>
	<key>NSRemindersFullAccessUsageDescription</key>
	<string>Virtues syncs your reminders to track tasks and to-dos alongside your other data.</string>
	<key>UIBackgroundModes</key>
	<array>
		<string>location</string>
		<string>fetch</string>
		<string>processing</string>
		<string>audio</string>
	</array>
</dict>
</plist>
