# Virtues relay environment — copy to /etc/virtues-relay.env, chmod 600.
# See deploy/relay/README.md.

# Client-facing listener (browsers/TLS passthrough). Production fronts :443.
VIRTUES_RELAY_CLIENT_ADDR=[::]:443
# Box-facing listener (boxes dial out here: control + work connections).
VIRTUES_RELAY_CONTROL_ADDR=[::]:9443

# atlas's Ed25519 PUBLIC key (hex, 32 bytes / 64 hex chars). The relay VERIFIES
# atlas-signed registration tokens with this — it is NOT a secret and holds no
# minting power (a relay compromise leaks only a public key). It must match the
# public half of atlas's VIRTUES_RELAY_SIGNING_KEY.
# Generate a keypair: see deploy/relay/README.md → "Generate the relay keypair".
VIRTUES_RELAY_PUBLIC_KEY=REPLACE_ME

# Previous atlas PUBLIC key, set ONLY during a zero-downtime key rotation: the
# relay accepts tokens signed by either key until the fleet has re-fetched. Clear
# it (unset/blank) once rollover is complete (>= one box token-refresh interval).
#VIRTUES_RELAY_PUBLIC_KEY_PREV=

# Do NOT set VIRTUES_RELAY_ALLOW_INSECURE / VIRTUES_RELAY_TOKEN in production —
# they exist only for local dev without a secret.
