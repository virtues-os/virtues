# Virtues relay environment — copy to /etc/virtues-relay.env, chmod 600.
# See deploy/relay/README.md.

# Client-facing listener (browsers/TLS passthrough). Production fronts :443.
VIRTUES_RELAY_CLIENT_ADDR=[::]:443
# Box-facing listener (boxes dial out here: control + work connections).
VIRTUES_RELAY_CONTROL_ADDR=[::]:9443

# Per-SNI HMAC secret — MUST match atlas's VIRTUES_RELAY_SECRET exactly (atlas
# mints the tokens this verifies). Generate once: `openssl rand -hex 32`.
# (This shared symmetric key is the thing we plan to replace with asymmetric
#  signing so the relay holds only a non-secret public key — see #6' / README.)
VIRTUES_RELAY_SECRET=REPLACE_ME

# Previous secret, set ONLY during a zero-downtime rotation: the relay accepts
# tokens minted under either secret until the fleet has re-fetched. Clear it
# (unset/blank) once rollover is complete (>= one box token-refresh interval).
#VIRTUES_RELAY_SECRET_PREV=

# Do NOT set VIRTUES_RELAY_ALLOW_INSECURE / VIRTUES_RELAY_TOKEN in production —
# they exist only for local dev without a secret.
