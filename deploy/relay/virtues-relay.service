[Unit]
Description=Virtues blind relay (L4 SNI passthrough)
Documentation=https://github.com/virtues-os/virtues/blob/main/deploy/relay/README.md
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
ExecStart=/usr/local/bin/virtues-relay
EnvironmentFile=/etc/virtues-relay.env
Restart=always
RestartSec=2

# Run as an ephemeral unprivileged user; grant ONLY the capability to bind the
# low ports (:443 client / :9443 control). No user to manage, no home, no shell.
DynamicUser=yes
AmbientCapabilities=CAP_NET_BIND_SERVICE
CapabilityBoundingSet=CAP_NET_BIND_SERVICE

# Resource bounds. The relay multiplexes many concurrent TCP connections, so the
# default 1024-FD limit is far too low. RAM stays small (RAM-only, no DB, no disk
# state) so MemoryMax is a leak-catcher, not a working limit — a healthy relay
# uses a tiny fraction of this.
LimitNOFILE=1048576
MemoryMax=1G
TasksMax=8192

# Hardening — the relay needs nothing but the network and its own binary.
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
RestrictAddressFamilies=AF_INET AF_INET6
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
SystemCallArchitectures=native
SystemCallFilter=@system-service
SystemCallFilter=~@privileged @resources

[Install]
WantedBy=multi-user.target
