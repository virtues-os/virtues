[Unit]
Description=Return the demo box to the demo life (demo box only)
After=postgresql.service
Requires=postgresql.service
OnFailure=alert-on-failure@%n.service

[Service]
Type=oneshot
User=postgres
ExecStart=/usr/bin/psql -X -1 -v ON_ERROR_STOP=1 -d virtues -f /usr/local/share/virtues/demo/reset.sql
