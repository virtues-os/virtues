[Unit]
Description=Virtues iroh-relay (relay.virtues.ch)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
# Optional env overrides. This used to be REQUIRED, to carry
# IROH_RELAY_HTTP_BEARER_TOKEN for the atlas access callout — that callout is
# gone (open admission; see config.toml), so a clean install needs no secret
# here and usually no file at all. Leading `-` so a missing file is not a
# startup failure.
EnvironmentFile=-/etc/iroh-relay/relay.env
ExecStart=/usr/local/bin/iroh-relay --config-path /etc/iroh-relay/config.toml
Restart=on-failure
RestartSec=3
# Bind :80/:443 (privileged) without running as root.
User=iroh-relay
Group=iroh-relay
AmbientCapabilities=CAP_NET_BIND_SERVICE
CapabilityBoundingSet=CAP_NET_BIND_SERVICE
StateDirectory=iroh-relay
# StateDirectory gives /var/lib/iroh-relay (cert_dir) owned by the service user.

# Hardening — the relay needs no filesystem beyond its state + no extra privs.
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
PrivateDevices=true
ProtectKernelTunables=true
ProtectControlGroups=true
RestrictAddressFamilies=AF_INET AF_INET6
ReadWritePaths=/var/lib/iroh-relay

[Install]
WantedBy=multi-user.target
