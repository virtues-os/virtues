{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "^Bash$",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$(git rev-parse --show-toplevel)/tools/hooks/no-destructive-git.sh\""
          },
          {
            "type": "command",
            "command": "python3 \"$(git rev-parse --show-toplevel)/tools/hooks/migration-guard.sh\""
          }
        ]
      },
      {
        "matcher": "^apply_patch$",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$(git rev-parse --show-toplevel)/tools/privacy-guard.py\" check --hook"
          }
        ]
      }
    ]
  }
}
