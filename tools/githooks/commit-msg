#!/usr/bin/env bash
# The commit message is published with the code, and no later file edit can
# reach it: a third party's real name and number once sat in a commit subject.
# The same two checks pre-commit runs on the files, on the message: check-pii
# (contact details outside the fictional blocks) and privacy-guard (the owner's
# real record, by hash).
#
# Installed with the other hooks by `make hooks` (core.hooksPath → tools/githooks).

set -uo pipefail

# Both run before either refuses, so one attempt names everything to fix.
failed=0
python3 tools/check-pii.py --message "$1" || failed=1
python3 tools/privacy-guard.py check --message "$1" || failed=1
exit "$failed"
