#!/usr/bin/env bash
# Every commit a push sends, not only the last: its added lines, its files, its
# message and its author. pre-commit sees one commit as it is made; a
# cherry-pick, a revert, a merge or a commit made in another clone never ran it,
# and everything in a push becomes public at once, in places no later rewrite
# fully reaches (forks, PR refs, crawlers).
#
# Git passes "<local ref> <local sha> <remote ref> <remote sha>" per ref on stdin.
#
# Installed with the other hooks by `make hooks` (core.hooksPath → tools/githooks).

set -uo pipefail

# Both run before either refuses, so one attempt names everything to fix.
refs=$(cat)
failed=0
printf '%s\n' "$refs" | python3 tools/check-pii.py --push || failed=1
printf '%s\n' "$refs" | python3 tools/privacy-guard.py check --push || failed=1
exit "$failed"
