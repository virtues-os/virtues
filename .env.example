# Environment Configuration
ENVIRONMENT=development

################################################
#    Authentication (Magic Link via Resend)    #
################################################

# Subscription tier (set by Atlas at provisioning)
# - standard: 1M tokens/month, 500GB drive, 4 Plaid connections
# - pro: 5M tokens/month, 4TB drive, 16 Plaid connections
TIER=standard

################################################
#         Development Mode Selection          #
################################################

# Database Configuration (Postgres)
# Local dev / appliance: postgres runs in Docker Compose at repo root.
# Bring it up with: `docker compose up -d db`.
#
# Three logical databases on the same dev Postgres instance:
#   `virtues`     — core / device DB
#   `virtues_api` — entitlement gate (WS-6b)
#   `atlas`       — billing + customer identity (WS-7)
#
# In prod, atlas and virtues-api SHOULD live on separate managed Postgres
# hosts (e.g., two Neon projects) for blast-radius isolation. The no-join
# lint enforces no shared columns regardless.
DATABASE_URL=postgres://virtues:virtues@localhost:5432/virtues
VIRTUES_API_DATABASE_URL=postgres://virtues:virtues@localhost:5432/virtues_api
VIRTUES_ATLAS_DATABASE_URL=postgres://virtues:virtues@localhost:5432/atlas

# Connection pool ceiling. Defaults if unset: 5 for core, 2 for action
# subprocesses. Keep low on 8GB hardware — every backend is ~10MB resident.
# DATABASE_MAX_CONNECTIONS=5

# Drive Storage
# Filesystem path where all user-uploaded files live (Drive, media, lake archives).
DRIVE_PATH=./.data/drive

################################################
#         Server Configuration                 #
################################################

PUBLIC_IP=localhost
FRONTEND_URL=http://localhost:3000

# Backend URL - used by Vite proxy, QR pairing (server_info), and OAuth callbacks
# For iOS QR pairing in dev, `cargo run -- tunnel` auto-sets this to the cloudflared URL
# e.g. BACKEND_URL=https://random-words.trycloudflare.com
BACKEND_URL=http://localhost:8000

################################################
#     Networking — WireGuard remote access     #
################################################

# Paired devices reach the box directly over the internet (IPv6-direct doctrine)
# through a WireGuard tunnel. These tune the WG daemon (`virtues-wireguard`).
# All optional — the defaults shown are what runs if unset.

# WG UDP listen port. Also the inbound firewall pinhole and the port baked into
# pairing bundles. Default 51820 (the WireGuard standard); a zero/bad value
# falls back to the default.
# VIRTUES_WG_LISTEN_PORT=51820

# Explicit public address to advertise in pairing bundles. Takes priority over
# auto-detection — set it when the box sits behind a port-forwarding router and
# you know the WAN address out-of-band. Auto-detection (the default) advertises
# ONLY a globally-routable address, never a LAN/NAT one; if it can't find one it
# reports "not directly reachable yet" rather than baking a dead endpoint.
# VIRTUES_WG_PUBLIC_IP=2001:db8::1

# Firewall management. By default the daemon adds ONE additive `ACCEPT` rule for
# the WG port (ip6tables + iptables) so a default-deny host is reachable — it
# never drops anything. Set to 0/false if you run your own firewall; then you
# must open inbound udp/<port> yourself. `virtues doctor` verifies real inbound
# reachability either way.
# VIRTUES_WG_MANAGE_FIREWALL=1

# Extra CSP `connect-src` origins (space-separated). The web UI's
# Content-Security-Policy allows same-origin plus the Virtues cloud endpoints
# (api/atlas) and ws/wss by default. A BYO deployment that fronts its own
# api/atlas on a custom domain appends those origins here so the browser doesn't
# block fetch/XHR/websocket to them. Everything else stays locked down.
# VIRTUES_CSP_CONNECT_SRC_EXTRA=https://api.example.com wss://api.example.com


# Logging Configuration
# Levels: error, warn, info, debug, trace
# Format: RUST_LOG=level,crate=level (e.g., warn,virtues=info)
# For clean startup: error (only shows errors)
# For debugging: info,virtues=debug (shows all logs)
RUST_LOG=error

# Security — master encryption key. Must be BASE64 of exactly 32 random bytes
# (NOT a 32-character passphrase). Generate with:  openssl rand -base64 32
# Or just run `make init`, which fills this in for you. Leave blank to force it.
VIRTUES_ENCRYPTION_KEY=

# Stream Encryption
# Lake/ELT archive files written under DRIVE_PATH are encrypted at rest using
# a key derived from this master key. Local-disk encryption is on the user —
# nothing else encrypts these files for you.
# Generate with: openssl rand -hex 32
STREAM_ENCRYPTION_MASTER_KEY=your_64_character_hex_stream_encryption_key_here_generate_with_openssl!

# Service Ports
WEB_PORT=3000

################################################
#             Source-specific envs             #
################################################

# OAuth proxy (WS-4): the OAuth dance now runs inside virtues-api (the Node
# apps/oauth-proxy is retired). The provider creds below are read by virtues-api.
# - Core points at it:        VIRTUES_OAUTH_PROXY_URL=<virtues-api URL>  (default https://auth.virtues.com)
# - virtues-api signs the short-lived exchange_token with this (>= 32 chars):
OAUTH_PROXY_EXCHANGE_SECRET=your-32-character-or-longer-exchange-secret!
# Redirect URIs below must point at wherever virtues-api serves /{provider}/callback.

# Google OAuth Configuration
GOOGLE_CLIENT_ID=your-google-client-id-here
GOOGLE_CLIENT_SECRET=your-google-client-secret-here
GOOGLE_REDIRECT_URI=https://auth.virtues.com/google/callback

# Google Places API (proxied through virtues-api for address autocomplete)
# Get your API key at: https://console.cloud.google.com/apis/credentials
# Enable: Places API (New) - server-to-server calls only
GOOGLE_API_KEY=your-google-api-key-here

# For testing the Rust library with real Google Calendar data:
# GOOGLE_REFRESH_TOKEN=your-refresh-token-here
# To get a refresh token:
# 1. Complete OAuth flow to get initial tokens
# 2. Copy the refresh_token from the sources table
# 3. Add it here for testing

# Notion OAuth Configuration
NOTION_CLIENT_ID=your-notion-client-id-here
NOTION_CLIENT_SECRET=your-notion-client-secret-here
NOTION_REDIRECT_URI=https://auth.virtues.com/notion/callback

# Strava OAuth Configuration
# Register at: https://www.strava.com/settings/api
STRAVA_CLIENT_ID=your-strava-client-id-here
STRAVA_CLIENT_SECRET=your-strava-client-secret-here

# GitHub OAuth Configuration
# Register at: https://github.com/settings/developers > OAuth Apps > New OAuth App
GITHUB_CLIENT_ID=your-github-client-id-here
GITHUB_CLIENT_SECRET=your-github-client-secret-here
GITHUB_REDIRECT_URI=https://auth.virtues.com/github/callback

# Plaid Configuration (Bank Account Integration)
# Sign up at: https://dashboard.plaid.com/signup
# For development, use sandbox credentials
# For production, request production access from Plaid
#
# IMPORTANT: Plaid keys are configured in VIRTUES-API (not Core) for security.
# Core calls virtues-api's /v1/services/plaid/* endpoints, which proxy to Plaid.
# This keeps Plaid credentials off user devices and enables budget enforcement.
#
# Set these in your .env for virtues-api:
PLAID_CLIENT_ID=your-plaid-client-id-here
PLAID_SECRET=your-plaid-secret-here
PLAID_ENV=sandbox  # Options: sandbox, development, production

# AI Configuration
# virtues-api - Self-hosted API proxy with budget enforcement
# Routes requests via litellm-rs to: anthropic/claude-*, openai/gpt-*, google/gemini-*, etc.
# Used for:
#   - Main chat interface (multi-model support with per-user budget tracking)
#   - Title generation (background job)
#   - Prudent context curation (4x daily background job)
#
# Two modes:
#   - Standalone: RAM-only budget tracking, default budget for all users
#   - Production: Hydrates from Atlas on startup, reports usage back to Atlas
VIRTUES_API_PORT=9002
VIRTUES_API_URL=http://localhost:9002
# Local-dev bearer. When set, virtues-core presents this verbatim and skips the
# vault/voucher path; a local virtues-api started with ENVIRONMENT=dev seeds a
# funded entitlement keyed by sha256(this) so it accepts the calls — no Stripe,
# no Atlas. Leave UNSET when pointing at the prod api (use the real vault bearer).
# The `make dev-api` + `make dev-core VIRTUES_API_URL=http://localhost:9002` flow
# wires this for you. Metering is fully real: the local api still calls the
# upstream gateway (real spend, fake wallet, $20/day + $5/call caps).
# VIRTUES_API_KEY=dev-local-key
# IMPORTANT: Must be at least 32 characters for security
# Shared secret for Core <-> virtues-api internal communication
# Generate with: openssl rand -base64 32
VIRTUES_API_INTERNAL_SECRET=your-32-character-or-longer-secret-key!
# Shared secret for virtues-api -> Core /internal/* endpoints (hydration, etc.)
# In production, requests to /internal/hydrate require X-Virtues-Api-Secret header
# In development (ENVIRONMENT != production), the secret check is skipped
VIRTUES_API_SECRET=your-32-character-or-longer-secret-key!
# Default budget for new users in USD (standalone mode)
VIRTUES_API_DEFAULT_BUDGET=5.0
# Usage reporting interval in seconds (when Atlas is configured)
VIRTUES_API_REPORT_INTERVAL=30

# Production mode flag (the installer writes ENVIRONMENT=production in prod)
# When set to "production", enables:
# - X-Virtues-Api-Secret validation on /internal/* endpoints
# - SSH-backed in-app terminal (/ws/terminal) instead of the dev echo loop
# - virtues-api hydration required before server_status becomes 'ready'
# In development, leave unset or set to "dev"
ENVIRONMENT=dev

# ─── Atlas (billing) service ───────────────────────────────────────────
# Atlas holds the customer/billing side of the wall. It mints billing
# tokens (/claim) and monthly vouchers (/voucher), and verifies Stripe
# webhooks. It shares NO database column with virtues-api — the voucher is
# the only thing that crosses, and it's discarded by both sides.
VIRTUES_ATLAS_PORT=9100
# Stripe (required for /claim + /voucher + webhooks in production)
STRIPE_SECRET_KEY=sk_test_your-stripe-secret-key
STRIPE_WEBHOOK_SECRET=whsec_your-webhook-signing-secret
# Device-link checkout (the `virtues claim` / web "Connect subscription" flow):
# the Stripe Price ID of the $29/mo plan, and the public URL a customer's
# browser reaches Atlas at (used to build the link + Stripe success/cancel URLs).
STRIPE_PRICE_ID=price_your-monthly-plan-price-id
VIRTUES_ATLAS_PUBLIC_URL=https://atlas.virtues.com
# Pre-order deposit checkout (POST /preorder/checkout). A one-time, fully
# refundable mode=payment session credited toward the hardware. The amount is
# defined inline (no dashboard Price needed) unless PREORDER_DEPOSIT_PRICE_ID is
# set. Success/cancel URLs should point at the marketing site.
PREORDER_DEPOSIT_AMOUNT_CENTS=5000          # $50
PREORDER_DEPOSIT_CURRENCY=usd
PREORDER_PRODUCT_NAME=Virtues Server — Pre-Order Deposit
PREORDER_PRODUCT_IMAGE=https://virtues.com/images/hero/study.jpg   # optional product image on the Checkout page
# PREORDER_DEPOSIT_PRICE_ID=price_your-deposit-price-id   # optional; inline if unset
PREORDER_SUCCESS_URL=https://virtues.com/pre-order/success
PREORDER_CANCEL_URL=https://virtues.com/pre-order
# Countries Checkout collects a shipping address for AND restricts to. US-only
# for the first batch — a non-US customer can't complete the deposit. Comma-
# separated ISO-3166 alpha-2 codes. Default "US" if unset.
PREORDER_ALLOWED_COUNTRIES=US
# Founder thank-you email (Resend) sent when a deposit settles. Atlas needs
# `RESEND_API_KEY` set in its own environment; leave unset to skip the send
# (deposit still records). `PREORDER_EMAIL_FROM` must be a Resend-verified
# sender; `PREORDER_EMAIL_REPLY_TO` is where customer replies land.
RESEND_API_KEY=your-resend-api-key-here
PREORDER_EMAIL_FROM=Adam at Virtues <adam@virtues.com>
PREORDER_EMAIL_REPLY_TO=adam@virtues.com
# Voucher economics (the $29/mo plan). Daily budget is a rate-limit, not
# the actual monthly cost — most users spend far less than the ceiling.
VOUCHER_DAILY_BUDGET_MICROS=5000000   # $5.00/day
VOUCHER_VALID_DAYS=30
VOUCHER_UNREDEEMED_DAYS=7              # unredeemed vouchers self-expire
VOUCHER_MIN_INTERVAL_DAYS=25          # anti-stacking: one voucher per ~month

# Vercel AI Gateway - Unified LLM access with ZDR (Zero Data Retention)
# Get your API key at: https://vercel.com/ai-gateway
# Supports all major providers: OpenAI, Anthropic, Google, xAI, etc.
# Model format: provider/model (e.g., anthropic/claude-sonnet-4.5, openai/gpt-4o)
AI_GATEWAY_API_KEY=your-vercel-ai-gateway-api-key-here
# Optional: Override the default gateway URL (https://ai-gateway.vercel.sh)
# AI_GATEWAY_URL=https://ai-gateway.vercel.sh

# Web Search Configuration
# Exa AI - Web search API for LLM tools
# Get your API key at: https://dashboard.exa.ai/api-keys
EXA_API_KEY=your-exa-api-key-here

# Unsplash - Free photo search for cover images
# Get your API key at: https://unsplash.com/developers
# Demo: 50 req/hour, Production: 5000 req/hour (apply at unsplash.com/developers)
UNSPLASH_ACCESS_KEY=your-unsplash-access-key-here


################################################
#            Test OAuth Tokens                 #
################################################

# OAuth refresh tokens for automated testing
# Generate these using: ./core/scripts/get_{provider}_token.sh
# These should be from dedicated test accounts (e.g., virtues-test@gmail.com)
# with known test data for predictable test results.
#
# See: core/docs/TESTING_OAUTH.md for detailed setup instructions

# Google Test Account Refresh Token
GOOGLE_TEST_REFRESH_TOKEN=your-google-test-refresh-token-here

# Notion Test Account Refresh Token (when implemented)
# NOTION_TEST_REFRESH_TOKEN=your-notion-test-refresh-token-here

# Strava Test Account Refresh Token (when implemented)
# STRAVA_TEST_REFRESH_TOKEN=your-strava-test-refresh-token-here

# Microsoft Test Account Refresh Token (when implemented)
# MICROSOFT_TEST_REFRESH_TOKEN=your-microsoft-test-refresh-token-here

################################################
#          Rate Limiting Configuration         #
################################################

# API Usage Rate Limits (optional - defaults shown)
# These limits protect against excessive API costs in instance-per-user deployments
# All limits enforce minimums to prevent disabling rate limiting entirely

# Daily chat requests limit (default: 1000, min: 1)
RATE_LIMIT_CHAT_DAILY=1000

# Daily token limit across all endpoints (default: 500000, min: 1000)
# Approximate cost: 500K tokens ≈ $1.50/day at current pricing
RATE_LIMIT_TOKENS_DAILY=500000

# Daily background job LLM calls limit (default: 100, min: 1)
# Background jobs include: prudent context curation, title generation, etc.
RATE_LIMIT_JOBS_DAILY=100

