  "query": "\n        SELECT id, subject_type, subject_id, kind, body, author, source_refs,\n               created_at, resolution\n        FROM wiki_notes\n        WHERE subject_type = $1 AND subject_id = $2\n          AND ($3 OR resolved_at IS NULL)\n        ORDER BY created_at DESC\n        ",
