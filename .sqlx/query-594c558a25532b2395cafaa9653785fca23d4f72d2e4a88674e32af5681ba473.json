  "query": "\n        SELECT\n            u.id,\n            u.email,\n            u.email_verified\n        FROM app_auth_session s\n        JOIN app_auth_user u ON s.user_id = u.id\n        WHERE s.session_token = $1 AND s.expires > now()\n        ",
