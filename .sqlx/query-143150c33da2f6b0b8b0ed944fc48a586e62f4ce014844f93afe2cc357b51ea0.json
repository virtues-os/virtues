  "query": "\n        SELECT\n            id,\n            latitude,\n            longitude,\n            occurred_at,\n            horizontal_accuracy\n        FROM data_location_point\n        WHERE occurred_at >= $1\n          AND occurred_at < $2\n          AND (horizontal_accuracy IS NULL OR horizontal_accuracy < $3)\n        ORDER BY occurred_at ASC\n        ",
