  "query": "\n        SELECT p.content, p.updated_at, (a.maintenance <> 'never') AS \"maintained!\"\n        FROM wiki_articles a\n        JOIN app_pages p ON p.id = a.page_id\n        WHERE a.subject_type = $1 AND a.subject_id = $2\n        ",
