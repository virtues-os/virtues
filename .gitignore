# Stray per-member Cargo.lock — the workspace root lock is canonical.
/virtues-core/Cargo.lock

# Built XCFramework + raw bindings from build-xcframework.sh (regenerate it;
# the app vendors the Swift binding under apps/ios/.../Tunnel/).
/crates/virtues-tunnel/generated/

# Environment variables
.env
.env.local
.env.*.local

# Keep .env.example files
!.env.example
!**/.env.example

# Backup / temp files (e.g. .env backups from `virtues init`, IDE .swp)
*.backup
*.bak
*.bak.*
*.swp
*.orig

# Postgres dumps — real box data must NEVER be committed (see `make dev-pull`).
# The dump lands in $TMPDIR, not here, but ignore the patterns as belt-and-suspenders.
*.dump
*.pgdump
*.rej

# SvelteKit build output (per-package generated)
.svelte-kit/

# NB: do NOT add `.sqlx/` — the CI release pipeline builds with
# SQLX_OFFLINE=true and requires the cache to be committed. Refresh via
# `cargo sqlx prepare --workspace` against a live local Postgres.

# Apple certificates and signing
*.p12
*.pfx
*.cer
*.certSigningRequest
*.mobileprovision
*.provisionprofile
Developer ID Application*

# Xcode
*.xcuserdata/
*.xcscheme
*.pbxuser
*.mode1v3
*.mode2v3
*.perspectivev3
xcuserdata/
*.xccheckout
*.moved-aside
DerivedData/
*.hmap
*.ipa
*.xcworkspace/xcuserdata/
*.xcodeproj/xcuserdata/
*.xcodeproj/project.xcworkspace/xcuserdata/
.ropeproject/
.conductor/

# macOS
.DS_Store
.AppleDouble
.LSOverride
Icon
._*
.DocumentRevisions-V100
.fseventsd
.Spotlight-V100
.TemporaryItems
.Trashes
.VolumeIcon.icns
.com.apple.timemachine.donotpresent
.AppleDB
.AppleDesktop
Network Trash Folder
Temporary Items
.apdisk

# Node.js
node_modules/

# Python environments
.venv/
venv/
env/
ENV/
__pycache__/
*.py[cod]
*$py.class
*.so

# Python lock files
uv.lock


.Python
build/
apps/mac/build/

# Build artifacts
apps/mac/virtues-mac
apps/mac/*.tar.gz
apps/mac/*.zip
apps/mac/*.dmg

# Git backups
.git-backup-*/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib64/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg

# Other
/target/
# Per-plugin Cargo build output (root `/target/` is anchored and misses these).
apps/web/plugins/*/target/
.data/
# Runtime box data — the data lake (.media blobs), DB scratch, etc. Never
# tracked: it's per-install state, not source. (The legacy `.data/` rule above
# missed the real dir, which is `data/`.)
/data/
tmp/*

/.pnpm-store
/apps/web/.pnpm-store
/apps/mac-source/.build
/crates/virtues-registry/target
/virtues-core/core/
/virtues-core/.sqlx

# Local Claude Code project state (runtime locks, local settings)
.claude/

# Chat/AI-authored applets materialize here per-box at runtime — they are
# local state, not shipped source (builtin applets live under applets/<name>/).
/applets/user/
/.applet-state/
